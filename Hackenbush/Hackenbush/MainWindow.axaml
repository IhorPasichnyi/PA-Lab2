<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hackenbush.MainWindow"
        Title="Hackenbush Game" 
        Width="700" Height="600"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <DockPanel Background="#1A1A1A">
        <!-- Верхня чорна панель керування -->
        <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="15,12" Margin="0">
            <StackPanel Spacing="10">
                <!-- 1. Текст ходу зверху -->
                <TextBlock x:Name="StatusTextBlock" 
                           Text="Хід: Гравець" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Center"/>

                <!-- 2. Кнопки та складність нижче -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                    <TextBlock Text="Складність:" Foreground="White" VerticalAlignment="Center" FontSize="14"/>
                    
                    <ComboBox x:Name="DifficultyComboBox" Width="140" Background="#333333" Foreground="White" BorderBrush="#555555">
                        <ComboBoxItem Content="Легкий" Tag="Easy"/>
                        <ComboBoxItem Content="Середній" Tag="Medium" IsSelected="True"/>
                        <ComboBoxItem Content="Складний" Tag="Hard"/>
                    </ComboBox>

                    <Button Content="Нова гра" 
                            Click="OnNewGameClicked" 
                            Padding="18,6" 
                            Background="White" 
                            Foreground="Black" 
                            FontWeight="SemiBold"
                            CornerRadius="3"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Полотно графа (білий background) -->
        <Border Margin="10,0,10,10" CornerRadius="4" ClipToBounds="True">
            <Canvas x:Name="GameCanvas" Background="White" PointerPressed="OnCanvasPointerPressed"/>
        </Border>
    </DockPanel>
</Window>